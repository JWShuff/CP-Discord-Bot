DISCORD_TOKEN="your_token_here"

EVENT_CHANNEL_ID="channel_id_here"
MOD_CHANNEL_ID="channel_id_here"

# Rough DM message:
# Your display name doesn't meet our server requirements. Please update it to: YourName - YourPlatoon (for example: "Alex - Delta" or "Sam - Avenger Platoon")
NAME_POLICY_REGEX="^\S.*\s*-\s*[A-Za-z]"
AUDIT_FREQUENCY=daily
GRACE_PERIOD_DAYS=7
